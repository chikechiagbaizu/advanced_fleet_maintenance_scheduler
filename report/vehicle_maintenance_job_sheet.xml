<?xml version="1.0" encoding="UTF-8"?>

<odoo>
    <data>
        <template id="report_vehicle_maintenance_job_sheet">
            <t t-call="web.html_container">
                <t t-foreach="docs" t-as="o">
                    <t t-call="web.external_layout">
                        <div class="page">
                            <h2>Maintenance Job Sheet</h2>
                            <h4>Vehicle Information</h4>
                            <table class="table table-sm">
                                <tr>
                                    <td>
                                        <strong>Job Reference</strong>
                                    </td>
                                    <td>
                                        <span t-field="o.display_name" />
                                    </td>
                                </tr>
                                <tr>
                                    <td>
                                        <strong>Vehicle</strong>
                                    </td>
                                    <td>
                                        <span t-field="o.vehicle_id" />
                                    </td>
                                </tr>
                                <tr>
                                    <td>
                                        <strong>Mechanic</strong>
                                    </td>
                                    <td>
                                        <span t-field="o.assigned_mechanic_id" />
                                    </td>
                                </tr>
                                <tr>
                                    <td>
                                        <strong>Status</strong>
                                    </td>
                                    <td>
                                        <span t-field="o.state" />
                                    </td>
                                </tr>
                            </table>

                            <h4>Parts Used</h4>
                            <table class="table table-sm">
                                <thead>
                                    <tr>
                                        <th>Part</th>
                                        <th class="text-end">Unit Cost</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr t-foreach="o.part_line_ids" t-as="line">
                                        <td>
                                            <span t-field="line.part_id.name" />
                                        </td>
                                        <td class="text-end">
                                            <span t-field="line.quantity" />
                                        </td>
                                        <td class="text-end">
                                            <span t-field="line.unit_cost" />
                                        </td>
                                        <td class="text-end">
                                            <span t-field="line.subtotal" />
                                        </td>
                                    </tr>
                                </tbody>
                            </table>

                            <div class="text-end">
                                <strong>Total Parts Cost: </strong>
                                <span t-field="o.total_parts_cost" />
                            </div>
                        </div>
                    </t>
                </t>
            </t>
        </template>
    </data>
</odoo>