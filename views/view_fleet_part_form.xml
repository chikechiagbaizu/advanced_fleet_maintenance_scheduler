<?xml version="1.0" encoding="UTF-8"?>

<odoo>
    <data>
        <!-- Form View -->
        <record id="fleet_part_form_view" model="ir.ui.view">
            <field name="name">fleet.part.form.view</field>
            <field name="model">fleet.part</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <group>
                            <field name="name" />
                            <field name="unit_cost" />
                        </group>
                    </sheet>
                </form>
            </field>
        </record>
    </data>
</odoo>